{
  "info": {
    "name": "UTS PPLOS B — NIM 80 — Tiket Event",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8000" },
    { "key": "access_token",  "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "event_id",      "value": "" },
    { "key": "category_id",   "value": "" },
    { "key": "order_id",      "value": "" },
    { "key": "qr_code",       "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:3001/health",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Ticket Service Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:3002/api/health",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Payment Service Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:3003/health",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('access_token', res.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.refresh_token);",
                  "  console.log('Token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Me (Get Profile)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('access_token', res.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/refresh",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        },
        {
          "name": "Google OAuth — Redirect",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/oauth/google",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events?page=1&per_page=10&status=active",
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "per_page",  "value": "10" },
                { "key": "status",    "value": "active" }
              ]
            },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Get Event by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/events/{{event_id}}",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('event_id', res.data.id);",
                  "  console.log('Event ID saved:', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/events",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Konser Ariana Grande\",\n  \"description\": \"Konser spesial Ariana Grande\",\n  \"location\": \"Gelora Bung Karno, Jakarta\",\n  \"event_date\": \"2026-08-17T19:00:00\"\n}"
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/events/{{event_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Konser Ariana Grande — Special Edition\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/events/{{event_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        }
      ]
    },
    {
      "name": "Ticket Categories",
      "item": [
        {
          "name": "List Categories by Event",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/events/{{event_id}}/categories",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('category_id', res.data.id);",
                  "  console.log('Category ID saved:', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/events/{{event_id}}/categories",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"VIP\",\n  \"description\": \"Kursi VIP paling depan\",\n  \"price\": 500000,\n  \"quota\": 100\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/orders?page=1&per_page=10",
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        },
        {
          "name": "Create Order (Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "  pm.collectionVariables.set('order_id', res.data._id);",
                  "  console.log('Order ID saved:', res.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_category_id\": \"{{category_id}}\",\n  \"quantity\": 2,\n  \"payment_method\": \"transfer\"\n}"
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/orders/{{order_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        },
        {
          "name": "Confirm Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.tickets && res.tickets.length > 0) {",
                  "  pm.collectionVariables.set('qr_code', res.tickets[0].qr_code);",
                  "  console.log('QR Code saved:', res.tickets[0].qr_code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/orders/{{order_id}}/confirm-payment",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "My Tickets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tickets?page=1&per_page=10",
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          }
        },
        {
          "name": "Validate QR",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/tickets/validate-qr",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_code\": \"{{qr_code}}\",\n  \"gate\": \"Gate A\",\n  \"validated_by\": \"Petugas 1\"\n}"
            }
          }
        }
      ]
    }
  ]
}